{
  "name": "inventory-image-database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile-first PWA for reviewing clothing inventory images, backed by Supabase.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "node scripts/verify-migrations.mjs",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "seed": "node --env-file=.env scripts/seed.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@supabase/supabase-js": "2.110.2"
  },
  "devDependencies": {
    "exceljs": "4.4.0",
    "sharp": "0.35.3",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
