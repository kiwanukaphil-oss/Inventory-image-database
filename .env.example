# Copy this file to ".env" and fill in the two values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# Both values are SAFE to expose in the browser bundle. The anon key only grants
# what Row Level Security allows, which is why the cost-data protection lives in
# the database, not in the client. Never put the SERVICE ROLE key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Phase B Railway read-only adapter (ADR-062). When set, login and catalog reads
# use the POS API; when absent, the existing Supabase production path is unchanged.
# VITE_CATALOG_API_URL=http://localhost:5000/api
